// Schema CSDL — website thông tin du lịch.
// Mô hình & quy ước: xem CLAUDE.md ("Mô hình dữ liệu cốt lõi").
// Engine: PostgreSQL (hỗ trợ native enum + String[]).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [unaccent]
}

// ============================================================
// ENUMS
// ============================================================

enum PlaceKind {
  province // Tỉnh
  destination // Điểm đến lớn
}

// Kiểu hero của trang chi tiết điểm đến — cài đặt CHUNG toàn site (SiteSetting):
// classic = 2 cột (chữ trái + deck ảnh phải), hợp nơi có nhiều ảnh điểm đến con;
// center  = ảnh tràn viền, tên đặt giữa, hợp nơi có một tấm ảnh đủ mạnh.
enum HeroLayout {
  classic
  center
}

// Cấu hình site dạng singleton (luôn 1 bản ghi id="singleton").
model SiteSetting {
  id           String     @id @default("singleton")
  siteName     String     @default("Halivivu")
  tagline      String?
  description  String? // mô tả meta (SEO)
  contactEmail String?
  facebookUrl  String?
  instagramUrl String?
  youtubeUrl   String?
  // Kiểu hero áp dụng cho MỌI trang điểm đến (cài đặt chung, không theo từng nơi).
  heroLayout   HeroLayout @default(center)
  updatedAt    DateTime   @updatedAt
}

enum PublishStatus {
  draft
  published
}

// Loại chủ đề diễn đàn cộng đồng (chỉ là nhãn phân loại, không cấu trúc riêng).
enum ThreadType {
  share // Chia sẻ trải nghiệm (đã đi)
  question // Hỏi đáp (chưa đi)
  trip // Tìm bạn đồng hành / rủ đi (sắp đi)
  discussion // Thảo luận chung
  sale // Rao dịch vụ — CHỈ CTV (SaleProfile) đã duyệt mới đăng được
}

// Trạng thái duyệt hồ sơ CTV (người bán). pending → approved | rejected.
enum SaleStatus {
  pending // vừa nộp, chờ staff duyệt
  approved // đã duyệt → công khai + có huy hiệu
  rejected // bị từ chối (kèm lý do)
}

// Loại kênh bị tố lừa đảo (công cụ kiểm tra uy tín).
enum ScamChannel {
  phone // SĐT / Zalo
  facebook // link/trang Facebook
  website // website
  bank_account // số tài khoản ngân hàng
}

// Trạng thái báo cáo lừa đảo. Chỉ confirmed mới hiện/đếm công khai.
enum ScamReportStatus {
  pending // chờ kiểm duyệt
  confirmed // đã xác nhận (hiện công khai)
  rejected // bác bỏ
}

// Loại thông báo (tương tác lên nội dung của người nhận).
enum NotificationType {
  thread_comment // bình luận bài cộng đồng của bạn
  thread_reply // trả lời bình luận cộng đồng của bạn
  thread_like // thích bài cộng đồng của bạn
  reply_like // thích bình luận cộng đồng của bạn
  blog_reply // trả lời bình luận blog của bạn
  sale_approved // hồ sơ CTV được duyệt
  sale_rejected // hồ sơ CTV bị từ chối
  thread_moderated // bài/bình luận cộng đồng của bạn bị staff ẩn/khóa
  trip_invite // được mời cùng sửa một lịch trình
}

// Lý do báo cáo một bài/bình luận cộng đồng.
enum ContentReportReason {
  spam // spam / quảng cáo
  scam // lừa đảo / lừa cọc
  offensive // xúc phạm / thù ghét
  offtopic // lạc chủ đề
  wrong_info // thông tin sai lệch
  other // khác (kèm ghi chú)
}

// Trạng thái xử lý báo cáo nội dung. pending → actioned | dismissed.
enum ContentReportStatus {
  pending // chờ staff xử lý
  actioned // đã xử lý (ẩn/khóa/xóa nội dung)
  dismissed // bỏ qua (không vi phạm)
}

// Cảm nhận chung của một review điểm đến (chọn 1) — thang 4 mức thay cho số sao.
enum ReviewStance {
  love // tuyệt vời, muốn quay lại
  worthOnce // đáng đi một lần
  meh // không có gì đặc biệt
  bad // thất vọng, không nên đi
}

/// Mức giá tương đối: budget=$ · moderate=$$ · premium=$$$ · luxury=$$$$
enum PriceRange {
  budget
  moderate
  premium
  luxury
}

enum SpotCategory {
  beach
  mountain
  waterfall
  lake
  cave
  temple
  viewpoint
  village
  island
  park
  other
}

enum EateryCategory {
  local
  seafood
  streetfood
  vegetarian
  cafe
  bbq
  other
}

// Đến để ĂN hay để UỐNG/NGỒI — trục VUÔNG GÓC với `category` (kiểu món).
// Tách ra vì quán nước/cà phê view được tìm theo cảnh chứ không theo bữa ăn.
enum VenueKind {
  eat // quán ăn
  drink // quán nước / cà phê / quán chè
  both // vừa ăn vừa ngồi lâu
}

// Hướng nhìn của quán — trục lọc chính cho quán view (thay tag chữ tự do).
enum ViewType {
  sea // biển
  valley // thung lũng
  cloud // biển mây
  mountain // núi
  lake // hồ
  river // sông
  city // phố / thành phố
  oldtown // phố cổ
  rice // ruộng bậc thang / đồng lúa
  garden // vườn / sân trong
}

// Bữa/khung giờ ăn — để khách lọc & xếp lịch ăn theo ngày.
enum Meal {
  breakfast // sáng
  lunch // trưa
  dinner // tối
  latenight // ăn đêm
  cafe // cà phê / giải khát
  snack // ăn vặt
}

enum AccommodationCategory {
  hotel
  homestay
  resort
  hostel
  guesthouse
  villa
}

enum ActivityCategory {
  adventure
  nature
  culture
  relax
  water
  food
  other
}

// Mức độ hoạt động (xem CLAUDE.md "Spot vs Activity"):
// experience = trải nghiệm/dịch vụ lớn (tour, lớp học) — nội dung dày, đặt chỗ;
// common     = hoạt động lặp ở nhiều spot, nội dung riêng theo từng spot (qua SpotActivity);
// spot       = đặc trưng nhỏ chỉ ở 1 spot, KHÔNG hiện ở cấp điểm đến.
enum ActivityKind {
  experience
  common
  spot
}

enum TransportDirection {
  getTo // đến nơi từ bên ngoài
  getAround // di chuyển tại chỗ
}

enum TransportMode {
  car
  bus
  train
  plane
  boat
  motorbike
  taxi
  grab
  bike
  walk
  cyclo
  shuttle
  other
}

enum UserRole {
  user
  editor
  admin
}

// ============================================================
// AUTH (NextAuth v5 / Prisma adapter) + role
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(user)
  homeProvince  String? // tỉnh/thành người dùng chọn (nơi ở / xuất phát) — cá nhân hoá sau này

  accounts Account[]
  sessions Session[]
  posts    Post[] // bài blog do user này viết
  likes    PostLike[] // bài đã tim
  comments Comment[] // bình luận đã viết

  threads       Thread[] // chủ đề cộng đồng đã đăng
  threadReplies ThreadReply[] // trả lời trong cộng đồng
  threadLikes   ThreadLike[] // chủ đề/trả lời đã thích

  notifications      Notification[] @relation("NotifRecipient") // thông báo nhận
  notificationsActed Notification[] @relation("NotifActor") // thông báo do mình gây ra

  checkIns        CheckIn[] // các điểm đến/tỉnh đã đánh dấu "đã đến"
  reviews         Review[] // đánh giá điểm đến đã viết
  trips           Trip[] // lịch trình chuyến đi (kể cả lịch trình mẫu nếu là editor)
  tripMemberships TripMember[] // chuyến của người khác mà mình được mời cùng sửa
  tripNotes       TripNote[]   @relation("TripNoteAuthor")
  tripPackItems   TripPackItem[] @relation("TripPackAssignee")
  tripPackChecks  TripPackCheck[] @relation("TripPackChecker")
  tripExpensesPaid TripExpense[] @relation("TripExpensePayer")
  tripExpensesDeleted TripExpense[] @relation("TripExpenseDeleter")
  tripExpenseShares TripExpenseShare[] @relation("TripExpenseSharer")

  saleProfile   SaleProfile?  @relation("SaleOwner") // hồ sơ CTV (nếu có) — đăng ký làm người bán
  salesReviewed SaleProfile[] @relation("SaleReviewer") // hồ sơ CTV mình đã duyệt (staff)

  reportsMade     ContentReport[] @relation("ReportsMade") // báo cáo nội dung đã gửi
  reportsReviewed ContentReport[] @relation("ReportsReviewed") // báo cáo mình đã xử lý (staff)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// PLACE — gộp Tỉnh + Điểm đến lớn (tự tham chiếu cha-con)
// Ràng buộc (app-level): province ⇒ parentId=null;
// destination ⇒ parent là province. Giữ đúng 2 mức.
// ============================================================

model Place {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  kind        PlaceKind
  tagline     String? // câu slogan ngắn hiển thị dưới tên (khác description)
  description String?

  // Vị trí hành chính (provinces.open-api.vn v2 — hiệu lực từ 1/7/2025: 34
  // tỉnh, 2 CẤP tỉnh → xã/phường/đặc khu; cấp huyện đã bị bãi bỏ). Lưu cả code
  // (để truy vấn/relink lại) và name (denormalized để hiển thị không gọi API).
  provinceCode Int?
  provinceName String?
  wardCode     Int?
  wardName     String?

  // Toạ độ trung tâm. Trước đây chỉ có bảng tra tay lib/place-coords.ts (theo
  // slug, không phủ hết) — giữ nguyên làm fallback, nhưng lịch trình cần toạ độ
  // thật trên bản ghi để ước tính quãng đường.
  lat Float?
  lng Float?

  parentId String?
  parent   Place?  @relation("PlaceTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Place[] @relation("PlaceTree")

  // Listing con (gắn qua placeId)
  activities     Activity[]
  spots          Spot[]
  specialties    Specialty[]
  eateries       Eatery[]
  accommodations Accommodation[]
  transports     Transport[]

  images       Image[]
  videos       PlaceVideo[] // video TikTok giới thiệu (hiển thị ở hero + modal)
  postRefs     PostRef[]
  threads      Thread[] // chủ đề cộng đồng gắn điểm đến này
  saleProfiles SaleProfile[] @relation("SaleAreas") // CTV phục vụ nơi này (M:N)
  // lượt xem theo ngày: xem model ViewStat (polymorphic, entityType='place')
  checkIns     CheckIn[] // người dùng đã đánh dấu "đã đến" nơi này
  reviews      Review[] // đánh giá của Vivu-er (chỉ điểm đến lớn)
  trips        Trip[]        @relation("TripPlace") // lịch trình gắn nơi này (mẫu + chuyến tạo từ trang này)

  tags String[] @default([])

  // TỈNH TỰ NÓ LÀ MỘT ĐIỂM ĐẾN (Ninh Bình, Huế, Đà Nẵng…): người ta nói "đi
  // Ninh Bình", không nói "đi một nơi nào đó trong Ninh Bình". Bật cờ này thì
  // tỉnh được xếp ngang hàng với các `destination` ở những chỗ liệt kê nơi để
  // đi — trước hết là dải thẻ trong `/diem-den`.
  //
  // Vì sao là một cờ RIÊNG, không mượn `isFeatured`: hai câu hỏi khác nhau.
  // `isFeatured` = "có đề cử nơi này lên trước không"; cờ này = "nơi này có tự
  // đứng thành một chuyến đi không". Quảng Ninh đang nổi bật vì nó CHỨA Hạ
  // Long, chứ bản thân nó không phải nơi người ta đặt vé tới.
  //
  // Chỉ có nghĩa với `kind = province`. Với `destination` thì thừa — nó vốn đã
  // là điểm đến; tầng app không đọc cờ này cho destination.
  treatAsDestination Boolean @default(false)

  // "Thông tin chung": vài thông tin nổi bật {label, value} biên tập trong CMS
  // (hiển thị trong thẻ cạnh phần giới thiệu ở trang Place)
  quickInfo Json?

  // AdminFields
  status      PublishStatus @default(draft)
  publishedAt DateTime?
  isFeatured  Boolean       @default(false)
  order       Int?
  popularity  Int           @default(0) // điểm tổng hợp (chưa dùng) — xem viewCount cho lượt xem thật
  viewCount   Int           @default(0) // tổng lượt xem all-time (tự tăng mỗi truy cập)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([kind])
  @@index([parentId])
  @@index([status])
}

// Lượt xem gộp theo ngày cho MỌI thực thể (place + listing): 1 dòng / thực thể / ngày.
// Polymorphic (entityType + entityId) — không FK để một bảng phủ được cả 6 loại;
// đổi lại khi xóa thực thể, dòng thống kê thành mồ côi (dọn ở delete action nếu cần).
// "trending N ngày" = sum(count) where entityType=… and date >= today - N.
model ViewStat {
  id         String   @id @default(cuid())
  entityType String // 'place' | 'activity' | 'spot' | 'specialty' | 'eatery' | 'accommodation'
  entityId   String
  date       DateTime @db.Date
  count      Int      @default(0)

  @@unique([entityType, entityId, date])
  @@index([date])
  @@index([entityType, entityId])
}

// CheckIn — người dùng đánh dấu "đã đến" một Place (tỉnh hoặc điểm đến lớn).
// Propagate: check-in điểm đến con tự tạo CheckIn cho tỉnh cha (auto=true);
// bỏ check-in chỉ gỡ tỉnh auto khi không còn con nào được check-in. Tỉnh đánh
// dấu trực tiếp (auto=false) luôn giữ. Thống kê X/63 đếm CheckIn của tỉnh.
model CheckIn {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Exclusive arc: đúng 1 trong place/spot được set (kiểm ở app).
  placeId String?
  place   Place?  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  spotId  String?
  spot    Spot?   @relation(fields: [spotId], references: [id], onDelete: Cascade)
  auto    Boolean @default(false) // true = tỉnh tự đánh dấu do check-in điểm đến con (chỉ place)

  createdAt DateTime @default(now())

  @@unique([userId, placeId])
  @@unique([userId, spotId])
  @@index([userId])
  @@index([placeId])
  @@index([spotId])
}

// Review điểm đến — CHỈ kind=destination (validate ở app). Gate app-level:
// author phải có CheckIn với place. Cảm nhận chung (stance, bắt buộc) + nhãn
// điểm cộng/cần lưu ý (vocab định nghĩa trong code, lưu String[]) + nội dung viết
// (tùy chọn). Hiện ngay; staff ẩn nếu cần. 1 review/người/điểm đến, sửa được.
model Review {
  id       String  @id @default(cuid())
  // Exclusive arc: đúng 1 trong place/spot được set (kiểm ở app).
  placeId  String?
  place    Place?  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  spotId   String?
  spot     Spot?   @relation(fields: [spotId], references: [id], onDelete: Cascade)
  authorId String
  author   User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  stance     ReviewStance
  highlights String[]     @default([]) // nhãn "điểm cộng" đã chọn
  caveats    String[]     @default([]) // nhãn "cần lưu ý" đã chọn
  content    String? // nội dung viết (tùy chọn)

  isHidden Boolean @default(false) // staff ẩn khỏi công khai (không tính vào tổng hợp)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([placeId, authorId])
  @@unique([spotId, authorId])
  @@index([placeId])
  @@index([spotId])
  @@index([authorId])
}

// ============================================================
// LISTINGS
// ============================================================

model Activity {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String? // mô tả ngắn (meta SEO, card, excerpt hero)
  content     String? // thân bài chi tiết: HTML (rich text) — tùy chọn (chủ yếu cho experience)
  kind        ActivityKind      @default(common)
  category    ActivityCategory?

  // Đơn vị khai thác / đặt chỗ (inline, không tách entity Provider)
  operatorName String?
  bookingUrl   String?
  phone        String?
  website      String?
  priceRange   PriceRange? // (giữ cho dữ liệu cũ; form dùng ticketTiers)
  ticketFree   Boolean     @default(false) // miễn phí tham gia
  ticketTiers  Json? // [{ label, price, note }] — giá VND, null/0 = miễn phí (xem lib/tickets)

  // Thực tế trải nghiệm (xem CLAUDE.md "Spot vs Activity")
  durationText String? // "nửa ngày", "2N1Đ", "~2 giờ"
  seasonText   String? // "tháng 9–11", "săn mây mùa thu"

  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  spotLinks SpotActivity[] // M:N qua bảng nối (mang nội dung riêng theo spot)

  images    Image[]
  postRefs  PostRef[]
  tripItems TripItem[]

  tags        String[]      @default([])
  status      PublishStatus @default(draft)
  publishedAt DateTime?
  isFeatured  Boolean       @default(false)
  order       Int?
  popularity  Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([placeId])
  @@index([category])
  @@index([status])
}

model Spot {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  tagline     String? // câu slogan ngắn hiển thị dưới tên (khác description)
  description String? // mô tả ngắn / mở bài (meta SEO, card, excerpt hero)
  category    SpotCategory?

  // PlaceableFields (cơ sở thực địa)
  address      String?
  lat          Float?
  lng          Float?
  openingHours String?
  phone        String?
  website      String?
  bookingUrl   String?
  mapUrl       String? // link bản đồ (Google Maps…)
  priceRange   PriceRange?

  // Vị trí hành chính (provinces.open-api.vn v2 — 2 cấp tỉnh → xã/phường; cấp
  // huyện đã bãi bỏ từ 1/7/2025). Lưu cả code (để tải cấp con) và name (hiển thị).
  provinceCode Int?
  provinceName String?
  wardCode     Int?
  wardName     String?

  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  // Thực tế về chỗ (xem CLAUDE.md "Spot vs Activity")
  bestTime     String? // mùa/giờ đẹp nhất — ngắn, cho chip hero ("sáng sớm")
  bestTimeNote String? // diễn giải "khi nào đẹp nhất" — đoạn cho mục riêng
  ticketFree   Boolean @default(false) // miễn phí vào cửa
  ticketTiers  Json? // [{ label, price, note }] — giá VND, null/0 = miễn phí (xem lib/tickets)
  ticketInfo   String? // ghi chú vé chung (giờ bán vé, ưu đãi…)
  notice       String? // cảnh báo truy cập: "Tạm đóng", "Cần xin phép leo"

  // Nội dung biên tập có khuôn (thay rich-text tự do)
  gettingThere String? // cách đến riêng cho địa điểm này (hướng dẫn, mẹo đường đi)
  tips         String[]        @default([]) // kinh nghiệm / mẹo — mỗi phần tử một gạch đầu dòng
  highlights   SpotHighlight[] // điểm nhấn (title + body + ảnh), sắp theo order

  activityLinks SpotActivity[] // M:N qua bảng nối (mang nội dung riêng theo spot)

  checkIns CheckIn[] // người dùng đã đánh dấu "đã đến" địa điểm này
  reviews  Review[] // đánh giá của Vivu-er cho địa điểm này
  threads  Thread[] // chủ đề cộng đồng gắn địa điểm này

  images    Image[]
  postRefs  PostRef[]
  videos    SpotVideo[] // video TikTok giới thiệu (hiển thị ở hero + modal)
  tripItems TripItem[]

  tags        String[]      @default([])
  status      PublishStatus @default(draft)
  publishedAt DateTime?
  isFeatured  Boolean       @default(false)
  order       Int?
  popularity  Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([placeId])
  @@index([category])
  @@index([status])
}

// Bảng nối Spot ↔ Activity mang nội dung RIÊNG theo từng spot.
// experience: blurb thường để trống (dùng content chung của Activity);
// common/spot: blurb + ảnh riêng cho spot này ("tắm biển ở Hòn Rơm"…).
model SpotActivity {
  id         String   @id @default(cuid())
  spotId     String
  spot       Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  order      Int      @default(0)
  blurb      String? // mô tả hoạt động này TẠI spot này
  imageUrl   String?
  imageAlt   String?

  @@unique([spotId, activityId])
  @@index([spotId])
  @@index([activityId])
}

// Điểm nhấn của một địa điểm — mỗi mục có tiêu đề, mô tả và ảnh riêng.
model SpotHighlight {
  id     String  @id @default(cuid())
  spotId String
  spot   Spot    @relation(fields: [spotId], references: [id], onDelete: Cascade)
  order  Int     @default(0)
  title  String
  body   String? // mô tả ngắn (rich text HTML)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spotId])
}

model Specialty {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?

  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  eateries Eatery[] @relation("SpecialtyEateries") // M:N

  images   Image[]
  postRefs PostRef[]

  tags        String[]      @default([])
  status      PublishStatus @default(draft)
  publishedAt DateTime?
  isFeatured  Boolean       @default(false)
  order       Int?
  popularity  Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([placeId])
  @@index([status])
}

model Eatery {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String?
  category    EateryCategory?
  venueKind   VenueKind       @default(eat) // ăn / uống / cả hai — quyết định section hiển thị

  // Quán view: lý do đến là CẢNH, không phải món.
  viewType ViewType? // hướng nhìn (null = không phải quán view)
  bestTime String? // giờ/mùa đẹp nhất, vd "5:30–7:00 mùa mây", "hoàng hôn"

  // PlaceableFields
  address      String?
  lat          Float?
  lng          Float?
  openingHours String?
  phone        String?
  website      String?
  bookingUrl   String?
  mapUrl       String? // link bản đồ (Google Maps…)

  // Vị trí hành chính (tự điền theo địa điểm cha; xem CLAUDE.md). Lưu cả code + name.
  provinceCode Int?
  provinceName String?
  wardCode     Int?
  wardName     String?

  meals  Meal[] // bữa phù hợp (sáng/trưa/tối/cà phê/ăn vặt) — để lọc
  notice String? // cảnh báo: "nghỉ thứ 2", "hết sớm", "chỉ bán sáng"

  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  specialties Specialty[] @relation("SpecialtyEateries") // M:N

  images    Image[]
  postRefs  PostRef[]
  tripItems TripItem[]

  tags        String[]      @default([])
  status      PublishStatus @default(draft)
  publishedAt DateTime?
  isFeatured  Boolean       @default(false)
  order       Int?
  popularity  Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([placeId])
  @@index([category])
  @@index([venueKind])
  @@index([status])
}

// Định vị: DANH BẠ chỗ ở ĐÃ XÁC MINH CHÍNH CHỦ — không phải OTA (xem CLAUDE.md
// "Đặc sản vs Quán ăn" / "Nơi lưu trú"). Giá trị lõi = kênh liên hệ thật đã kiểm
// chứng + huy hiệu xác minh + cảnh báo chống lừa cọc. KHÔNG làm đặt phòng/calendar.
model Accommodation {
  id          String                 @id @default(cuid())
  slug        String                 @unique
  name        String
  description String?
  category    AccommodationCategory?

  // PlaceableFields
  address      String?
  lat          Float?
  lng          Float?
  openingHours String?
  phone        String?
  website      String?
  bookingUrl   String?

  // Kênh liên hệ chính chủ (thực tế VN: Zalo là kênh chốt phòng chính)
  zalo        String? // SĐT/link Zalo chính chủ
  facebookUrl String? // page/profile chính chủ (để khách đối chiếu, tránh page nhái)

  // Xác minh chính chủ — lõi định vị (FB group KHÔNG cung cấp được)
  isVerified   Boolean   @default(false) // đã xác minh đây là chủ thật
  verifiedAt   DateTime? // mốc xác minh (audit)
  verifiedNote String? // nội bộ: cách xác minh (gọi điện, gặp trực tiếp…) — KHÔNG hiện public

  // An toàn giao dịch / chống lừa cọc
  depositPolicy String? // chính sách cọc bằng lời ("Cọc 50% qua chính chủ", "Không cọc trước")
  notice        String? // cảnh báo: "Chỉ liên hệ qua kênh hiển thị tại đây", "Hết phòng mùa lễ"…

  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  images    Image[]
  postRefs  PostRef[]
  tripItems TripItem[]

  tags        String[]      @default([])
  status      PublishStatus @default(draft)
  publishedAt DateTime?
  isFeatured  Boolean       @default(false)
  order       Int?
  popularity  Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([placeId])
  @@index([category])
  @@index([status])
  @@index([isVerified])
}

// Transport: hiển thị INLINE trên trang Place — không slug, không trang chi tiết,
// không là đích PostRef. Vẫn lưu DB và có thể có ảnh.
model Transport {
  id          String             @id @default(cuid())
  name        String
  description String?
  direction   TransportDirection
  mode        TransportMode

  fromName   String? // chỉ getTo
  duration   String?
  distanceKm Float?
  priceFrom  Int?
  priceTo    Int?
  currency   String? @default("VND")

  operatorName String?
  bookingUrl   String?
  phone        String? // hotline đặt/hỏi (nhà xe, hãng taxi…) — hỗ trợ chống chặt chém
  notice       String? // cảnh báo/mẹo: "đặt trước dịp lễ", "chốt giá trước"

  isRecommended Boolean @default(false) // cách phổ biến/khuyên dùng (decision-support)

  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  images Image[]

  status      PublishStatus @default(draft)
  publishedAt DateTime?
  order       Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([placeId])
  @@index([direction])
  @@index([status])
}

// ============================================================
// IMAGE — một ảnh thuộc đúng MỘT chủ sở hữu (exclusive arc:
// đúng một trong các FK dưới đây được set). Cascade theo chủ.
// ============================================================

// Ảnh trưng bày (gallery) hay ảnh TẤM THỰC ĐƠN (menu). Tách bằng một trường
// thay vì một bảng riêng: menu ở đây chỉ là ảnh, không có tên món / giá.
// BẤT BIẾN: ảnh `menu` KHÔNG BAO GIỜ được `isCover = true` — nhờ vậy mọi truy
// vấn ảnh bìa sẵn có (`where: { isCover: true }`) tự loại nó ra, không phải đi
// sửa từng chỗ. Chỗ nào lấy cả gallery (không lọc isCover) thì phải tự lọc
// `kind: gallery`.
enum ImageKind {
  gallery
  menu
}

model Image {
  id      String    @id @default(cuid())
  url     String
  alt     String?
  caption String?
  credit  String?
  order   Int       @default(0)
  isCover Boolean   @default(false)
  kind    ImageKind @default(gallery)

  placeId         String?
  place           Place?         @relation(fields: [placeId], references: [id], onDelete: Cascade)
  activityId      String?
  activity        Activity?      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  spotId          String?
  spot            Spot?          @relation(fields: [spotId], references: [id], onDelete: Cascade)
  specialtyId     String?
  specialty       Specialty?     @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  eateryId        String?
  eatery          Eatery?        @relation(fields: [eateryId], references: [id], onDelete: Cascade)
  accommodationId String?
  accommodation   Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  transportId     String?
  transport       Transport?     @relation(fields: [transportId], references: [id], onDelete: Cascade)
  postId          String?
  post            Post?          @relation(fields: [postId], references: [id], onDelete: Cascade)
  threadId        String?
  thread          Thread?        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  tripId          String?
  trip            Trip?          @relation(fields: [tripId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([placeId])
  @@index([activityId])
  @@index([spotId])
  @@index([specialtyId])
  @@index([eateryId])
  @@index([eateryId, kind]) // lấy riêng ảnh thực đơn của một quán
  @@index([accommodationId])
  @@index([transportId])
  @@index([postId])
  @@index([threadId])
  @@index([tripId])
}

// Video TikTok gắn vào Place (giới thiệu điểm đến). Chỉ lưu videoId của TikTok
// (vd 7486790456437787925) + caption; thumbnail lấy runtime qua oEmbed.
model PlaceVideo {
  id        String   @id @default(cuid())
  placeId   String
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  videoId   String // ID video TikTok
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placeId])
}

// Video TikTok gắn vào Spot (địa điểm nhỏ). Giống PlaceVideo: chỉ lưu videoId
// + caption; thumbnail lấy runtime qua oEmbed.
model SpotVideo {
  id        String   @id @default(cuid())
  spotId    String
  spot      Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  videoId   String // ID video TikTok
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spotId])
}

// ============================================================
// BLOG
// ============================================================

model Post {
  id       String  @id @default(cuid())
  slug     String  @unique
  title    String
  excerpt  String?
  content  String // HTML (rich text TipTap)
  category String? // phân loại bài (editorial, để linh hoạt): cam-nang | am-thuc | ...

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  refs     PostRef[]
  images   Image[]
  likes    PostLike[]
  comments Comment[]

  tags        String[]      @default([])
  status      PublishStatus @default(draft)
  publishedAt DateTime?
  isFeatured  Boolean       @default(false)
  order       Int?
  popularity  Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([authorId])
  @@index([status])
}

// PostRef — liên kết bài viết tới Place/Listing (đích có trang).
// Exclusive arc: đúng một trong các FK target được set. (Không gồm Transport.)
model PostRef {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  order  Int    @default(0)

  placeId         String?
  place           Place?         @relation(fields: [placeId], references: [id], onDelete: Cascade)
  activityId      String?
  activity        Activity?      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  spotId          String?
  spot            Spot?          @relation(fields: [spotId], references: [id], onDelete: Cascade)
  specialtyId     String?
  specialty       Specialty?     @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  eateryId        String?
  eatery          Eatery?        @relation(fields: [eateryId], references: [id], onDelete: Cascade)
  accommodationId String?
  accommodation   Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([placeId])
  @@index([activityId])
  @@index([spotId])
  @@index([specialtyId])
  @@index([eateryId])
  @@index([accommodationId])
}

// PostLike — "tim" bài viết (M:N User↔Post). Mỗi user tim 1 bài tối đa 1 lần.
model PostLike {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

// Comment — thảo luận dưới bài viết. Lồng 1 cấp: reply gắn parentId trỏ tới
// một comment gốc (parentId = null). Không cho reply của reply (validate ở app).
model Comment {
  id       String @id @default(cuid())
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content  String

  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([parentId])
  @@index([authorId])
}

// ============================================================
// CỘNG ĐỒNG (diễn đàn UGC) — Thread + ThreadReply + ThreadLike
// Khác blog: do người dùng đăng, hiện ngay; staff ghim/khóa/ẩn.
// Ảnh để inline trong body (rich-text qua Jodit/UploadThing) — không entity riêng.
// ============================================================
model Thread {
  id    String     @id @default(cuid())
  slug  String     @unique
  title String? // tiêu đề tùy chọn (bài kiểu Facebook không cần)
  body  String // nội dung dạng văn bản (status), hiển thị whitespace-pre-wrap
  type  ThreadType @default(discussion)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  placeId String? // (tùy chọn) gắn điểm đến để lọc & cross-link
  place   Place?  @relation(fields: [placeId], references: [id], onDelete: SetNull)

  spotId String? // (tùy chọn) gắn địa điểm nhỏ để lọc & cross-link
  spot   Spot?   @relation(fields: [spotId], references: [id], onDelete: SetNull)

  tags String[] @default([])

  // Chỉ dùng cho type=trip (tìm bạn đồng hành) — giúp lọc/nhắc chuyến sắp đi.
  departDate DateTime? // ngày khởi hành dự kiến
  slots      Int? // số chỗ / số người cần tìm

  isPinned Boolean @default(false) // staff ghim lên đầu
  isLocked Boolean @default(false) // khóa không cho trả lời
  isHidden Boolean @default(false) // staff ẩn khỏi công khai

  replyCount     Int      @default(0) // denormalize để list nhanh
  lastActivityAt DateTime @default(now()) // sắp theo "hoạt động gần đây"

  replies ThreadReply[]
  likes   ThreadLike[]
  images  Image[] // ảnh đính kèm (bài kiểu Facebook)
  reports ContentReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([placeId])
  @@index([spotId])
  @@index([authorId])
  @@index([isPinned, lastActivityAt])
}

model ThreadReply {
  id       String @id @default(cuid())
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content  String // văn bản thường (hiển thị whitespace-pre-wrap)

  parentId String?
  parent   ThreadReply?    @relation("ThreadReplyChildren", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ThreadReply[]   @relation("ThreadReplyChildren")
  likes    ThreadLike[]
  reports  ContentReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threadId])
  @@index([parentId])
  @@index([authorId])
}

// Báo cáo một bài (Thread) HOẶC một trả lời (ThreadReply) vi phạm — do người dùng
// gửi, staff xử lý ở CMS. Exclusive arc: đúng 1 trong threadId/replyId được set.
// Mỗi người chỉ báo cáo một đích tối đa 1 lần (unique).
model ContentReport {
  id     String              @id @default(cuid())
  reason ContentReportReason
  note   String? // mô tả thêm (bắt buộc khi reason=other)
  status ContentReportStatus @default(pending)

  reporterId String
  reporter   User   @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)

  threadId String?
  thread   Thread?      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  replyId  String?
  reply    ThreadReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)

  reviewedById String? // staff đã xử lý
  reviewedBy   User?   @relation("ReportsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String? // ghi chú xử lý (nội bộ)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([threadId, reporterId])
  @@unique([replyId, reporterId])
  @@index([status])
  @@index([threadId])
  @@index([replyId])
}

// Thích/hữu ích cho chủ đề HOẶC trả lời (exclusive arc: đúng 1 trong 2 FK).
model ThreadLike {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  threadId String?
  thread   Thread?      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  replyId  String?
  reply    ThreadReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([threadId, userId])
  @@unique([replyId, userId])
  @@index([userId])
}

// Hồ sơ CTV / người bán (sale) — DANH BẠ người bán ĐÃ XÁC MINH, song song với
// Accommodation. Người dùng tự đăng ký (pending) → staff duyệt (approved) → hiện
// huy hiệu + được đăng Thread(type=sale) + có trang cá nhân /sale/[slug].
// 1:1 với User: sự tồn tại của hồ sơ = "là sale"; status=approved = huy hiệu công khai.
model SaleProfile {
  id     String @id @default(cuid())
  slug   String @unique
  userId String @unique
  user   User   @relation("SaleOwner", fields: [userId], references: [id], onDelete: Cascade)

  displayName String
  bio         String?
  services    String[] @default([]) // bán gì: tour | phong | ve | combo | thue-xe | tour-tu-thiet-ke ...

  // Kênh liên hệ (như Accommodation) — được đối chiếu whitelist khi kiểm tra uy tín
  zalo        String?
  phone       String?
  facebookUrl String?
  website     String?

  avatarUrl String? // ảnh đại diện công khai (fallback User.image)

  // Duyệt / xác minh
  status            SaleStatus @default(pending)
  verifiedAt        DateTime? // mốc được duyệt (approved)
  reVerifyDueAt     DateTime? // hạn tái xác minh (uy tín cũ đi)
  verificationLevel String? // basic | standard | high (theo SOP)
  verifiedNote      String? // NỘI BỘ: đã xác minh gì — KHÔNG hiện public
  evidenceUrls      String[]   @default([]) // NỘI BỘ: ảnh bằng chứng (GPKD, MST…) — chỉ staff xem
  rejectReason      String? // lý do từ chối (hiện cho chính chủ)
  reviewedById      String?
  reviewedBy        User?      @relation("SaleReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  notice String? // cảnh báo an toàn hiển thị cho khách

  areas Place[] @relation("SaleAreas") // khu vực phục vụ (M:N)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Báo cáo lừa đảo từ cộng đồng (blacklist) — cho công cụ kiểm tra uy tín.
// BẮT BUỘC bằng chứng + kiểm duyệt; chỉ confirmed mới hiện/đếm công khai.
// reporterId/reviewedById lưu dạng cột thường (không FK) để đỡ ràng buộc.
model ScamReport {
  id              String           @id @default(cuid())
  channel         ScamChannel
  valueNorm       String // giá trị đã chuẩn hoá — để đối chiếu khi tra
  valueRaw        String // giá trị gốc người báo nhập
  reason          String? // lý do ngắn (vd "lừa cọc", "page nhái")
  description     String? // mô tả chi tiết sự việc
  evidenceUrls    String[]         @default([]) // ảnh bằng chứng (bắt buộc ≥1)
  reporterId      String? // user báo cáo (nếu đăng nhập)
  reporterContact String? // liên hệ người báo (nếu ẩn danh)
  status          ScamReportStatus @default(pending)
  reviewedById    String? // staff đã kiểm duyệt
  reviewNote      String? // ghi chú kiểm duyệt (nội bộ)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([channel, valueNorm])
  @@index([status])
}

// Thông báo khi có người tương tác lên nội dung của người nhận.
model Notification {
  id      String           @id @default(cuid())
  userId  String // người nhận
  user    User             @relation("NotifRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId String // người gây ra tương tác
  actor   User             @relation("NotifActor", fields: [actorId], references: [id], onDelete: Cascade)
  type    NotificationType

  url     String // đích khi bấm vào (vd /cong-dong/<slug>)
  excerpt String? // trích đoạn nội dung liên quan (để hiển thị ngữ cảnh)

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ============================================================
// LỊCH TRÌNH CHUYẾN ĐI — Trip + TripDay + TripItem
// Thiết kế đầy đủ & lý do từng quyết định: docs/lich-trinh.md.
// Định vị: sổ tay chuyến đi (gom → xếp ngày → cảnh báo khả thi → chia sẻ),
// KHÔNG phải nền tảng đặt chỗ. Bắt đăng nhập, dữ liệu nằm trong DB.
// ============================================================

// Vai trong một chuyến. CỐ Ý chỉ hai vai, KHÔNG có `viewer`: ai chỉ cần xem thì
// đã có link chia sẻ (visibility=unlisted). Thêm vai thứ ba là thêm một trục
// quyền mà không giải quyết vấn đề nào mới. Xem docs/lich-trinh-cong-tac.md §2.
enum TripRole {
  owner
  editor
}

enum TripVisibility {
  private // chỉ chủ sở hữu
  unlisted // ai có link đều xem được (không index)
}

model Trip {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  title     String
  summary   String? // 1 câu — card + SEO (chủ yếu cho lịch trình mẫu)
  startDate DateTime? @db.Date // null = chuyến chưa định ngày
  partySize Int? // số người — CHỈ hiển thị, không dùng để tính tiền

  // Chia sẻ: shareId sinh khi bật chia sẻ (null = chưa từng bật).
  shareId    String?        @unique
  visibility TripVisibility @default(private)

  // Lịch trình mẫu do biên tập soạn — dùng CHUNG bảng này, chỉ khác cờ.
  isTemplate Boolean @default(false)
  slug       String? @unique // CHỈ template — /lich-trinh/[slug]
  // Điểm đến chính của chuyến. Với TEMPLATE: nơi nó được gắn để hiện ở trang
  // điểm đến. Với chuyến của người dùng: nơi bấm "Lên lịch trình đi X" — đặt
  // lúc tạo và KHÔNG bảo trì về sau (chuyến mở rộng sang tỉnh khác vẫn giữ
  // nguyên), nên chỉ dùng làm gợi ý và đường quay lại, đừng coi là chân lý.
  placeId    String?
  place      Place?  @relation("TripPlace", fields: [placeId], references: [id], onDelete: SetNull)

  days    TripDay[]
  items   TripItem[]
  images  Image[] // ảnh bìa (template)
  members TripMember[]
  invites TripInvite[]
  notes    TripNote[]
  packing  TripPackItem[]
  expenses TripExpense[]

  // Khoá lạc quan cho THAO TÁC THEO VỊ TRÍ. `moveItem` đánh số lại cả một vùng
  // chứa, nên hai người cùng kéo trong một ngày sẽ ghi đè nhau LẶNG LẼ: người
  // sau gửi "đặt ở chỉ số 2" tính trên bàn đã cũ. Mọi mutation tăng số này;
  // client gửi kèm số nó đang thấy, lệch thì bị từ chối và buộc làm mới.
  // Xem docs/lich-trinh-cong-tac.md §3.
  version Int @default(0)

  // AdminFields — thực chất chỉ template dùng tới status/publishedAt/isFeatured/order.
  status      PublishStatus @default(draft)
  publishedAt DateTime?
  isFeatured  Boolean       @default(false)
  order       Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([ownerId])
  @@index([isTemplate, status])
  @@index([placeId])
}

// Người được mời cùng sửa một chuyến. Chủ chuyến vẫn là Trip.ownerId (xoá
// chuyến, quản lý thành viên, bật/tắt chia sẻ) — bảng này chỉ nói ai được SỬA
// NỘI DUNG.
// Ghi chú của cả chuyến — mã đặt phòng, số hiệu chuyến bay, số chủ homestay,
// dặn dò cả nhóm. KHÁC ba chỗ ghi chú đã có: `TripItem.note` nói về một điểm
// dừng, `TripDay.note` nói về một ngày (chỉ mẫu), `Trip.summary` là mô tả của
// MẪU và chỉ sửa được trong CMS.
//
// Vì sao NHIỀU MẨU chứ không phải một ô text dùng chung trên `Trip`: dự án cố ý
// không có realtime cho phần sửa lịch trình (docs/lich-trinh-cong-tac.md §5).
// Một tài liệu chung mà không có realtime thì hai người cùng gõ là người lưu sau
// ghi đè sạch, im lặng. Điều quyết định không phải xác suất mà là BÁN KÍNH THIỆT
// HẠI: ghi đè một tài liệu chung xoá mọi thứ cả nhóm đã viết, ghi đè một mẩu chỉ
// xoá một mẩu. Chi tiết: docs/lich-trinh-cong-cu-nhom.md §11.3.
model TripNote {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // CHỮ THUẦN, không phải HTML rich-text. Thứ ghi chú cần chỉ là xuống dòng và
  // link bấm được — link được nhận diện lúc HIỂN THỊ (dựng bằng JSX nên không
  // có mặt phẳng XSS). Xem §11.4.
  body String @db.Text

  // SetNull: gỡ một người khỏi chuyến không được xoá ghi chú họ để lại.
  authorId String?
  author   User?   @relation("TripNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  // Ghim lên đầu — thay cho sắp xếp tay. Mẩu tham chiếu (mã đặt phòng) sẽ chìm
  // dần khi danh sách xếp mới-nhất-trước; ghim là cách rẻ nhất để giữ nó ở trên.
  isPinned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId, isPinned, createdAt])
}

// Món đồ CHUNG của nhóm hay ĐỒ RIÊNG mỗi người tự lo.
//
//   • `group`    — một cái cho cả nhóm (lều, loa, bộ sạc). Có người nhận, và
//                  trạng thái là CHUNG: Minh xếp rồi thì cả nhóm coi như xong.
//   • `personal` — ai cũng phải mang một cái (bàn chải, thuốc riêng). KHÔNG có
//                  người nhận, và trạng thái là RIÊNG TỪNG NGƯỜI → lưu ở
//                  `TripPackCheck`, không dùng hai cờ dưới đây.
enum TripPackScope {
  group
  personal
}

// Danh sách đồ mang theo. Vấn đề nó giải: không phải "quên mang quần áo" (ai
// cũng nhớ) mà là **ba người cùng mang sạc dự phòng, không ai mang lều** — tức
// là chuyện PHÂN CÔNG đồ chung. Vì vậy trục chính là `assigneeId`.
//
// HAI LƯỢT DUYỆT, đúng cách người ta chuẩn bị thật:
//   1. `isReady`  — "đã có sẵn": mấy hôm trước, soát xem trong nhà CÓ chưa,
//                   thiếu thì còn kịp mua/mượn.
//   2. `isPacked` — "đã xếp vào túi": tối trước hôm đi, soát lần cuối.
// Gộp hai lượt vào một ô tick là đánh mất đúng chỗ hay hỏng: có sẵn ở nhà không
// có nghĩa là nó đã nằm trong túi.
//
// Cố ý KHÔNG có: `qty` (tên món tự nói — "2 ổ cắm"), `category` (phân loại là
// việc của bốn mục, không phải của một cái nhãn — cùng lý do đã bỏ nó ở
// `TripNote`), `order` (đây là checklist, không phải lịch trình: không ai xếp
// lại thứ tự đồ đạc). Chi tiết: docs/lich-trinh-cong-cu-nhom.md §12.
model TripPackItem {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  name  String
  scope TripPackScope @default(group)

  // Ai mang — CHỈ có nghĩa với `group`. SetNull: gỡ một người khỏi chuyến thì
  // món đồ quay về "chưa ai nhận" chứ không biến mất.
  assigneeId String?
  assignee   User?   @relation("TripPackAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Trạng thái CHUNG — chỉ dùng cho `group`. Món `personal` đọc/ghi ở TripPackCheck.
  isReady  Boolean @default(false)
  isPacked Boolean @default(false)

  checks TripPackCheck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId, createdAt])
}

// Trạng thái RIÊNG của từng người cho một món `personal`. Không có bản ghi =
// chưa tick gì — không tạo sẵn cho mọi người × mọi món (một chuyến 5 người ×
// 30 món đã là 150 dòng rỗng).
model TripPackCheck {
  id     String       @id @default(cuid())
  itemId String
  item   TripPackItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId String
  user   User         @relation("TripPackChecker", fields: [userId], references: [id], onDelete: Cascade)

  isReady  Boolean @default(false)
  isPacked Boolean @default(false)

  @@unique([itemId, userId])
  @@index([userId])
}

// Một khoản đã chi trong chuyến — AI TRẢ và CHIA CHO NHỮNG AI.
//
// ⚠️ Đây KHÔNG phải "ước tính chi phí" mà docs/lich-trinh.md §9.3 đã bỏ. Chỗ đó
// nói về việc SUY RA giá từ danh mục (`Eatery`, `Accommodation`…) — mọi con số
// kiểu đó sẽ sai một cách vô hình. Ở đây số là do người dùng GÕ VÀO, nên nó
// luôn đúng với thứ họ biết. Bất biến giữ nguyên: không bao giờ tự điền tiền
// từ dữ liệu danh mục.
//
// `amount` là **ĐỒNG, số nguyên**. Không có `currency` (dự án chỉ phục vụ du
// lịch trong nước), không có `category` (phân loại là việc của các mục, không
// phải một cái nhãn — cùng lý do đã bỏ ở TripNote/TripPackItem).
model TripExpense {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  title  String
  amount Int

  // Ai ứng tiền. SetNull: gỡ người khỏi chuyến thì khoản chi vẫn còn (nó đã xảy
  // ra rồi), chỉ mất tên người trả.
  paidById String?
  paidBy   User?   @relation("TripExpensePayer", fields: [paidById], references: [id], onDelete: SetNull)

  // Chia ĐỀU cho những người có mặt trong `shares`. Cố ý không có số tiền trên
  // từng phần: chia theo tỉ lệ/số lẻ là bài toán khác hẳn, và nhóm bạn đi chơi
  // gần như luôn chia đều.
  shares TripExpenseShare[]

  // XOÁ MỀM, không xoá thật. Đây là sổ tiền của cả nhóm — ai trong chuyến cũng
  // xoá được, nên một người "gian" có thể lặng lẽ rút một hoá đơn khỏi sổ và
  // không ai biết. Xoá mềm biến việc đó thành công khai: khoản đã xoá vẫn nằm
  // trong mục "Đã xoá" kèm TÊN NGƯỜI XOÁ và khôi phục lại được. Xoá thật chỉ
  // xảy ra khi cả chuyến bị xoá (Cascade).
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("TripExpenseDeleter", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId, createdAt])
}

model TripExpenseShare {
  id        String      @id @default(cuid())
  expenseId String
  expense   TripExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("TripExpenseSharer", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([userId])
}

model TripMember {
  id     String   @id @default(cuid())
  tripId String
  trip   Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   TripRole @default(editor)

  addedById String? // ai mời (chỉ để hiển thị)
  createdAt DateTime @default(now())

  @@unique([tripId, userId])
  @@index([userId])
}

// Lời mời cho email CHƯA có tài khoản. Site chỉ đăng nhập bằng OAuth nên không
// gửi được mail xác thực riêng — thay vào đó giữ lời mời ở đây, và lần đầu
// người đó đăng nhập bằng đúng email này thì tự thành thành viên (xem
// `claimTripInvites` gọi trong sự kiện signIn ở auth.ts).
model TripInvite {
  id     String   @id @default(cuid())
  tripId String
  trip   Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  email  String // luôn lưu ở dạng thường (lowercase)
  role   TripRole @default(editor)

  invitedById String?
  createdAt   DateTime @default(now())

  @@unique([tripId, email])
  @@index([email])
}

model TripDay {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  index    Int // 0-based
  // Giờ bắt đầu ngày tính bằng PHÚT từ 00:00 (480 = 08:00) — khớp thẳng với
  // openingStatus() trong lib/opening-hours, khỏi phải đổi múi giờ ở giữa.
  startMin Int     @default(480)
  title    String?
  note     String?

  items TripItem[]

  @@unique([tripId, index])
  @@index([tripId])
}

model TripItem {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // null = TÚI ĐỒ (đã lưu nhưng chưa xếp vào ngày nào). Cố ý nullable: người
  // dùng gom trước, xếp sau — bắt chọn ngày ngay lúc bấm "thêm" là ma sát.
  dayId String?
  day   TripDay? @relation(fields: [dayId], references: [id], onDelete: SetNull)

  order   Int
  stayMin Int? // null → mặc định theo loại (xem lib/trip-time.ts)
  note    String?

  // Exclusive arc — đúng 1 FK được set (convention của Image/PostRef).
  //
  // KHÔNG có: specialtyId (Specialty đang tắt) · transportId (Transport là nội
  // dung hướng dẫn) · và KHÔNG có placeId — một Place là NƠI CHỨA các điểm
  // dừng, không phải một điểm dừng: nó không có giờ mở cửa để cảnh báo, toạ độ
  // chỉ là trọng tâm các listing, và "ở lại Phan Thiết 2 tiếng" thì vô nghĩa.
  // Trang điểm đến vì vậy có nút "Lên lịch trình đi X" thay cho "Thêm vào lịch
  // trình" (xem docs/lich-trinh.md §6b). Cần đánh dấu ngày nào thuộc điểm đến
  // nào thì chỗ đúng là TripDay.placeId, không phải ở đây.
  spotId          String?
  spot            Spot?          @relation(fields: [spotId], references: [id], onDelete: Cascade)
  eateryId        String?
  eatery          Eatery?        @relation(fields: [eateryId], references: [id], onDelete: Cascade)
  accommodationId String?
  accommodation   Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  activityId      String?
  activity        Activity?      @relation(fields: [activityId], references: [id], onDelete: Cascade)

  // …hoặc mục TỰ NHẬP (chuyến bay, nhà người quen — thứ site không có).
  customTitle String?
  customLat   Float?
  customLng   Float?

  createdAt DateTime @default(now())

  @@index([tripId])
  @@index([dayId])
}
